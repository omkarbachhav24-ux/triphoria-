# TRIPHORIA Environment Variables Template
# Copy to .env for local development. On Vercel, set these in
# Project Settings -> Environment Variables (NOT in a committed file).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Only needed if the API is deployed on a DIFFERENT origin than the frontend.
# Leave unset for a single same-origin Vercel deployment (recommended).
# FRONTEND_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Database — Supabase Postgres (SERVER-ONLY)
# ---------------------------------------------------------------------------
# Use the Supabase "Connection Pooling" string in *Transaction* mode (port 6543).
# Project Settings -> Database -> Connection string -> "Transaction pooler".
# Example shape (fill in the real password / region):
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin seed credentials (SERVER-ONLY)
# Consumed once, only when the users table is empty (first boot).
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@triphoria.io
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional: override the seeded editor / customer passwords (else random in prod).
# EDITOR_SEED_PASSWORD=
# CUSTOMER_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Storage token signing (SERVER-ONLY) — REQUIRED, no fallback.
# HMAC key for presigned upload/download tokens. With NODE_ENV=production the
# server refuses to boot if this is missing; in other envs the storage-token
# endpoints throw 503 until it is set. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
STORAGE_SECRET=

# ---------------------------------------------------------------------------
# Frontend (PUBLIC — safe to expose in the browser bundle)
# Currently unused by the app; reserved for future direct Supabase Storage
# access from the client. The publishable key is NOT the service-role key.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# NOTE: SUPABASE_SERVICE_ROLE_KEY is intentionally NOT used by the current
# implementation (the API talks to Postgres directly via DATABASE_URL).
# Do not add it unless/until server-side Supabase Storage is implemented,
# and never prefix it with VITE_.
